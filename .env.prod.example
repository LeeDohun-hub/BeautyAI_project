# docker-compose.prod.yml 용 환경변수 예시. 복사해서 .env.prod 로 쓰고 값을 채운다.
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# .env.prod 는 .gitignore 의 `.env.*` 에 걸려 커밋되지 않는다.

# --- 필수 ---
# 운영 DB(Supabase). 없으면 컨테이너가 뜨지 않는다.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# --- 공개 접점 ---
# 호스트에서 열릴 포트. 프론트 nginx 는 컨테이너 내부 8080 고정.
WEB_PORT=8080
# 백엔드를 별도 도메인에 둘 때만 채운다. 비워두면 같은 오리진(/api) → nginx 프록시.
VITE_API_BASE_URL=
# 백엔드를 직접 노출할 때만 의미가 있다(프록시만 쓰면 무시해도 된다).
CORS_ORIGINS=http://localhost:8080

# --- 외부 API (없으면 해당 소스의 상품 링크·이미지가 비게 된다) ---
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_REFERER=http://localhost:8080/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
