# 프로덕션 백엔드 — 런타임 번들(모델·카탈로그)을 **이미지에 넣는다**.
#
# 개발용 backend/Dockerfile 과 다른 점:
#   1) 빌드 컨텍스트가 저장소 루트다(번들이 backend/ 밖의 dist/runtime_data 에 있어서).
#      → 루트 .dockerignore 가 data/(18GB) 등을 잘라내므로 컨텍스트는 작게 유지된다.
#   2) dist/runtime_data 를 /data 로 COPY 한다. 볼륨 마운트가 필요 없어져 배포가 이미지
#      하나로 끝나고, '번들 없이 떠서 기능이 조용히 죽는' 사고를 원천 차단한다
#      (2026-07-28 카탈로그 0건, 2026-07-30 ASIN 검증파일 누락 — 둘 다 이 부류였다).
#
# ⚠ /data 여야 한다. 컨테이너 안에서 config.project_root(=parents[3])가 '/'로 풀리므로
#   코드가 찾는 ./data/models/... 는 /data/models/... 가 된다. /app/data 가 아니다.
#
# 빌드(저장소 루트에서):
#   python scripts/build_runtime_bundle.py
#   docker build -f backend/Dockerfile.prod -t beautyai-backend:<tag> .
FROM python:3.11-slim

WORKDIR /app

# mediapipe/opencv 런타임에 필요한 시스템 라이브러리(libGL, GLib 등)
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
# 퍼스널컬러/피부/네일 모델(EfficientNet·YOLOv8) 추론용 PyTorch(CPU 전용).
# ⚠️ requirements.txt **보다 먼저** 깔아야 한다. ultralytics 가 torch 를 요구하는데, 순서가
# 뒤바뀌면 pip 가 PyPI 기본 torch(CUDA 빌드)를 끌어와 nvidia-*(2.7GB)+triton(0.7GB)이
# 이미지에 남는다(실측: 3.23GB → 10.2GB). 먼저 깔면 요구사항이 이미 충족돼 CUDA 를 받지 않는다.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision
RUN pip install --no-cache-dir -r requirements.txt

# 번들을 코드보다 먼저 넣는다 — 코드는 자주 바뀌고 번들은 드물게 바뀌므로,
# 이 순서라야 코드만 고쳤을 때 372MB 레이어를 다시 만들지 않는다(캐시 재사용).
COPY dist/runtime_data /data

# 번들이 비었는지 **빌드 시점에** 확인한다. COPY 는 빈 디렉터리도 성공하므로, 이 검사가
# 없으면 모델·카탈로그 없는 이미지가 조용히 만들어져 런타임에 기능만 죽는다(실측 2회).
RUN test -d /data/models && test -d /data/manifests \
    && test -s /data/manifests/amazon_dead_asins.txt \
    && test -s /data/manifests/amazon_asin_status.json \
    || (echo "런타임 번들이 비었거나 불완전합니다. 먼저 'python scripts/build_runtime_bundle.py' 를 실행하세요." && exit 1)

COPY backend/app ./app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
