# Local default (SQLite file at project root):
DATABASE_URL=sqlite:///./beautyai.db
# Supabase / Postgres (use the Session pooler or Direct connection string from
# Supabase > Project Settings > Database). Keep the real password in .env only:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
#
# ⚠️ 여기에 **운영 DB** 를 넣지 마세요. 운영 DB 를 알아보면 백엔드가 부팅을 거부합니다
#    (app/core/database.py guard_production_db). 개발용 Supabase 프로젝트를 따로 쓰세요.
#    운영 데이터를 정말 봐야 할 때만 아래를 켭니다 — 켜는 순간 실수가 곧 운영 사고입니다.
# ALLOW_PRODUCTION_DB=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHROMA_PATH=./data/rag/chromadb
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SKIN_MODEL_PATH=./data/models/skin_efficientnet_b0.pt
BODY_SKIN_MODEL_PATH=./data/models/body_skin_mobilenet_v3.pt
PROBLEM_SKIN_KNOWLEDGE_PATH=./data/rag/problem_skin_knowledge.jsonl
# 네이버 쇼핑 검색 API (실시간 입점 확인용). 발급: https://developers.naver.com
# 두 값이 모두 있어야 네이버 입점 확인이 켜지고, 없으면 모든 플랫폼 버튼이 그대로 노출됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
