# 개발 DB — 로컬 Postgres(운영과 **같은 엔진**). 이걸 기본으로 쓰세요.
#   docker compose up -d postgres
#   python scripts/seed_dev_db.py       ← 로컬 CSV 로 카탈로그를 채운다(운영 접근 없음)
DATABASE_URL=postgresql+psycopg2://beautyai:beautyai@localhost:5433/beautyai
#
# sqlite 도 되지만 방언이 달라 Postgres 에서만 나는 문제를 못 잡는다. 테스트 전용으로만.
# DATABASE_URL=sqlite:///./beautyai.db
#
# ⚠️ 여기에 **운영 DB** 를 넣지 마세요. 운영 DB 를 알아보면 백엔드가 부팅을 거부합니다
#    (app/core/database.py guard_production_db).
#    운영 데이터를 정말 봐야 할 때만 아래를 켭니다 — 켜는 순간 실수가 곧 운영 사고입니다.
# ALLOW_PRODUCTION_DB=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHROMA_PATH=./data/rag/chromadb
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SKIN_MODEL_PATH=./data/models/skin_efficientnet_b0.pt
BODY_SKIN_MODEL_PATH=./data/models/body_skin_mobilenet_v3.pt
PROBLEM_SKIN_KNOWLEDGE_PATH=./data/rag/problem_skin_knowledge.jsonl
# 네이버 쇼핑 검색 API — ⚠️ **2026-07-31 종료됐습니다. 새로 발급받지 마세요.**
#   종료된 API 는 예외가 아니라 **200 OK + 빈 결과**를 돌려줍니다. 그래서 자격증명을 넣어도
#   에러 없이 조용히 0건이 되고, '설정을 잘못했나' 로 시간을 씁니다(app/services/naver_kr_enricher.py:147).
#   지금 한글명·이미지는 로컬 카탈로그(올리브영 글로벌 / 아마존)에서 옵니다 — 키가 없어도 정상입니다.
#   두 값은 죽은 경로를 위해 남겨둔 자리이고, 비워 두는 것이 기본입니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_REFERER=http://127.0.0.1:5173/
KAGGLE_USERNAME=leedohoon1217
KAGGLE_KEY=
KAGGLE_API_KEY=
PEXELS_API_KEY=
PAYPAY_ENVIRONMENT=sandbox
PAYPAY_API_KEY=
PAYPAY_API_SECRET=
PAYPAY_MERCHANT_ID=
VITE_PAYPAY_MERCHANT_ID=

# ── 운영·정책 스위치 ──────────────────────────────────────────────────────────
# 아래는 **전부 기본값으로 동작**하므로 평소엔 건드릴 일이 없습니다. 다만 있는 줄 모르면
# 필요할 때 못 찾으므로 여기에 적어 둡니다(설명 원본은 app/core/config.py).

# 운영 컨테이너만 production 을 받습니다(docker-compose.prod.yml). 로컬은 그대로 두세요.
# APP_ENV=local

# 운영 DB 를 알아보는 조각(Supabase 프로젝트 ref). DATABASE_URL 에 이 문자열이 있으면
# 운영 DB 로 보고 부팅을 거부합니다. ⚠️ 운영 DB 를 옮기면 이 값도 같이 바꿔야 가드가 삽니다.
# PRODUCTION_DB_MARKER=ekmelstemgzjbjppoalg

# 개인정보 보관 기간(일). 지난 분석·설문·추천이력·상담기록을 scripts/expire_user_data.py 가 지웁니다.
# ⚠️ 365 는 개발팀이 정한 기본값이지 법무·정책이 확정한 값이 아닙니다. 0 이면 만료하지 않습니다.
# DATA_RETENTION_DAYS=365

# AI 자체 세션 수명(시간). 이 시간이 지나면 모든 API 가 401 이 되고 로그인 게이트가 다시 섭니다.
# AI_SESSION_EXP_HOURS=12

# 결과지 QR(장바구니 핸드오프) 코드 수명(분). 1회용이라 다 쓰면 바로 죽습니다.
# CART_HANDOFF_EXP_MINUTES=30

# 일본몰 비포/애프터 노출 스위치. 법무 회신이 '해당한다'로 오면 **이 값만** false 로 바꾸면 됩니다
# (재배포 불필요). 스위치를 미리 만들어 둔 것이 이 항목의 목적입니다.
# JP_BEFORE_AFTER=true

# ── 모델 경로·판정 임계값 ─────────────────────────────────────────────────────
# 퍼스널컬러/네일 모델 경로와 임계값(PERSONAL_COLOR_*, AIHUB_PC_*, NAIL_*)은 기본값으로 돌아갑니다.
# 실측 근거가 값마다 주석으로 붙어 있으니 **바꾸기 전에 app/core/config.py 를 먼저 읽으세요** —
# 예: PERSONAL_COLOR_BORDERLINE_THRESHOLD 는 커버리지↔정밀도 트레이드오프라 올리면 확신 답변이 줄어듭니다.
